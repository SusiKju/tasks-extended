rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Hilfsfunktionen ────────────────────────────────────────────────────────

    // Ist der anfragende User in dieser Familie Mitglied?
    function isFamilyMember(familyId) {
      return request.auth != null
          && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    // Ist der anfragende User eingeloggt?
    function isSignedIn() {
      return request.auth != null;
    }

    // ── userFamilies: schnelle Familien-Nachschlag pro User ────────────────────
    // Nur der User selbst darf seinen eigenen Eintrag lesen/schreiben.
    match /userFamilies/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ── familyCodes: Beitrittscode-Lookup ─────────────────────────────────────
    // Jeder eingeloggte User darf einen Code lesen (zum Beitreten).
    // Erstellt wird der Code nur beim createFamily – kein direktes Schreiben durch User.
    match /familyCodes/{code} {
      // Einzelnen Code nachschlagen ja – ganze Tabelle auflisten nein (sonst
      // kann jeder eingeloggte User alle familyId aller Familien einsammeln).
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn();
      allow update, delete: if false; // Codes sind unveränderlich
    }

    // ── Familie (Hauptstruktur) ────────────────────────────────────────────────
    match /families/{familyId} {

      // Meta-Dokument: alle Mitglieder lesen, kein direktes Schreiben
      allow read: if isFamilyMember(familyId);
      allow create: if isSignedIn(); // createFamily schreibt das erste Mal
      // TE-59: fuerUnsUids ist eine bewusst engere Allowlist als "alle
      // Mitglieder" – nur wer selbst schon drinsteht, darf das Feld ändern
      // (Annehmen einer Beitrittsanfrage mit Für-uns-Zugriff, oder späteres
      // Verwalten in den Einstellungen). Alle anderen Felder bleiben für
      // jedes Mitglied änderbar wie bisher.
      allow update: if isFamilyMember(familyId)
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['fuerUnsUids'])
            || request.auth.uid in resource.data.fuerUnsUids
          );
      allow delete: if false;

      // Beitrittsanfragen (TE-59): ein Beitrittscode legt nur noch eine
      // Anfrage an, kein Mitglieds-Dokument. Erst ein bestehendes Mitglied
      // kann sie bestätigen (approved:true) – siehe members/create unten.
      match /joinRequests/{uid} {
        allow read: if isFamilyMember(familyId) || (isSignedIn() && request.auth.uid == uid);
        allow create: if isSignedIn() && request.auth.uid == uid
            && request.resource.data.approved == false
            && request.resource.data.joinCode is string
            && get(/databases/$(database)/documents/familyCodes/$(request.resource.data.joinCode)).data.familyId == familyId;
        // Bestätigen (approved:true setzen) darf nur ein bestehendes Mitglied –
        // die Anfrage selbst kann sich nicht freischalten.
        allow update: if isFamilyMember(familyId);
        // Ablehnen/Aufräumen durch ein Mitglied, oder eigene Anfrage zurückziehen.
        allow delete: if isFamilyMember(familyId) || (isSignedIn() && request.auth.uid == uid);
      }

      // Mitglieder-Liste
      match /members/{uid} {
        // Mitglieder lesen alle; User darf eigenes Dokument lesen (z.B. beim Beitreten prüfen)
        allow read: if isFamilyMember(familyId) || (isSignedIn() && request.auth.uid == uid);
        // Selbst-Eintrag erlaubt für:
        //  a) den Familien-Gründer beim Anlegen (createFamily)
        //  b) einen bestätigten Beitritt (completeJoin) – NUR wenn die eigene
        //     joinRequests/{uid} mit approved:true vorliegt. Ersetzt seit
        //     TE-59 die reine joinCode-Prüfung: ein Code allein reicht nicht
        //     mehr, ein bestehendes Mitglied muss aktiv zustimmen.
        allow create: if isSignedIn() && request.auth.uid == uid
            && (
              get(/databases/$(database)/documents/families/$(familyId)).data.createdByUid == request.auth.uid
              || get(/databases/$(database)/documents/families/$(familyId)/joinRequests/$(uid)).data.approved == true
            );
        allow delete: if isSignedIn() && request.auth.uid == uid;
        allow update: if isFamilyMember(familyId) || (isSignedIn() && request.auth.uid == uid);
      }

      // Kinder-Konfiguration (addChild, updateChild, deleteChild)
      match /childrenConfig/{childId} {
        allow read, write: if isFamilyMember(familyId);
      }

      // Kinder-Aufgaben, Aktivitätslog, pushToken, Belohnung
      match /children/{childId} {
        allow read, write: if isFamilyMember(familyId);

        match /tasks/{taskId} {
          allow read, write: if isFamilyMember(familyId);
        }

        match /activity/{entryId} {
          allow read, write: if isFamilyMember(familyId);
        }
      }

      // Push-Trigger (Eltern → Kind)
      match /pushTriggers/{childId} {
        allow read, write: if isFamilyMember(familyId);
      }

      // Server-Spiegel des Kinder-Modus pro Gerät (TE-59, siehe childDevice.ts).
      // deviceId ist keine uid – jedes Familienmitglied darf lesen/schreiben,
      // genau wie bei childrenConfig.
      match /childDeviceById/{deviceId} {
        allow read, write: if isFamilyMember(familyId);
      }

      // App-Konfiguration (Erinnerungszeiten)
      match /config/{docId} {
        allow read, write: if isFamilyMember(familyId);
      }

      // Geteilte Notizliste (TE-59: von {document=**} auf den tatsächlich
      // genutzten Pfad eingeschränkt – siehe Begründung bei "Für uns" unten.
      // sharedNotes.ts schreibt ausschließlich unter shared/notepad/items/*.)
      match /shared/notepad/items/{itemId} {
        allow read, write: if isFamilyMember(familyId);
      }

      // "Für uns" (TE-59): eigene, engere Allowlist statt Familienmitgliedschaft.
      // WICHTIG: Firestore kombiniert überlappende match-Blöcke mit ODER, nicht
      // "spezifischster Pfad gewinnt" – ein zusätzlicher shared/{document=**}
      // daneben hätte diese Regel wirkungslos gemacht (isFamilyMember allein
      // hätte weiter gereicht, per Live-Test gegen die echten Prod-Rules
      // bestätigt: Lenny konnte trotz dieser Regel lesen). Deshalb ist die
      // shared-Notizen-Regel oben auf ihren echten Pfad eingeschränkt, damit
      // hier NUR diese engere Regel greift.
      match /shared/fuerUns/items/{itemId} {
        allow read, write: if isFamilyMember(familyId)
            && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.fuerUnsUids;
      }

      // Countdown-Karten pro User (TE-171: vorher geteilt unter shared/countdowns)
      match /countdownsByUser/{uid}/items/{itemId} {
        allow read, write: if isFamilyMember(familyId) && request.auth.uid == uid;
      }

      // Persönlicher Scratchpad pro User
      match /scratchpadByUser/{uid} {
        allow read, write: if isFamilyMember(familyId) && request.auth.uid == uid;
      }

      // "Mein Tag"-Feed: manuelle Sortierung pro User
      match /feedOrderByUser/{uid} {
        allow read, write: if isFamilyMember(familyId) && request.auth.uid == uid;
      }

      // "Mein Tag"-Feed: per Long-Press hervorgehobenes Item pro User (TE-95)
      match /feedHighlightByUser/{uid} {
        allow read, write: if isFamilyMember(familyId) && request.auth.uid == uid;
      }

      // App-Settings pro User (TE-49)
      match /settingsByUser/{uid} {
        allow read, write: if isFamilyMember(familyId) && request.auth.uid == uid;
      }

      // E-Mail-Pins pro User (TE-50)
      match /mailPinsByUser/{uid} {
        allow read, write: if isFamilyMember(familyId) && request.auth.uid == uid;
      }

      // Wichtig-Label der Tasks pro User (TE-123)
      match /importantTasksByUser/{uid} {
        allow read, write: if isFamilyMember(familyId) && request.auth.uid == uid;
      }

      // Persönliche Notizen pro User
      match /personalNotesByUser/{uid}/notes/{noteId} {
        allow read, write: if isFamilyMember(familyId) && request.auth.uid == uid;
      }

      // Persönliche Gedanken-Kacheln pro User
      match /geistesKachelByUser/{uid}/tiles/{tileId} {
        allow read, write: if isFamilyMember(familyId) && request.auth.uid == uid;
      }

      // Schnelle Notizen pro User (TE-148)
      match /quickNotesByUser/{uid}/notes/{noteId} {
        allow read, write: if isFamilyMember(familyId) && request.auth.uid == uid;
      }

      // Persönliche Linkliste pro User (TE-32)
      match /linksByUser/{uid}/links/{linkId} {
        allow read, write: if isFamilyMember(familyId) && request.auth.uid == uid;
      }
    }

    // ── Fokus-Kachel: strikt privat pro User, nicht geteilt (TE-7/TE-10/TE-12) ──
    // Bewusst außerhalb von families/: keine Familienmitgliedschaft nötig,
    // ausschließlich der Eigentümer (uid) darf lesen/schreiben.
    match /focusTilesByUser/{uid}/themes/{theme} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ── Bambini-Kinder-Registry: strikt privat pro User (TE-18) ───────────────
    // Genau wie focusTilesByUser bewusst außerhalb von families/.
    match /bambiniByUser/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ── Alle anderen Dokumente: kein Zugriff ──────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
